          {
            "status_code": 500,
            "body": {
              "error": "<error_message>"
            },
            "description": "Internal server error"
          }
        ]
      },
      "notes": [
        "Active user: User who created or updated a diary entry in the time period",
        "Engagement rate: (active_users / total_users) * 100, rounded to 2 decimal places",
        "Time periods:",
        "  - today: From midnight UTC today to now",
        "  - this_week: From Monday 00:00 UTC to now",
        "  - this_month: From 1st of current month 00:00 UTC to now",
        "  - last_7_days: Rolling 7 days (last 6 days + today)",
        "  - last_30_days: Rolling 30 days (last 29 days + today)",
        "  - last_90_days: Rolling 90 days (last 89 days + today)",
        "Graph data:",
        "  - daily: Last 30 days (30 data points)",
        "  - weekly: Last 12 weeks (12 data points)",
        "  - monthly: Last 12 months (12 data points)",
        "All dates and times are in UTC",
        "Graph data is formatted for easy visualization in frontend charts"
      ]
    }
  ],
  "common_headers": {
    "Authorization": {
      "format": "Bearer <admin_token>",
      "required_for": [
        "/admin/users",
        "/admin/users/<user_id>",
        "/admin/engagement"
      ],
      "example": "Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..."
    },
    "Content-Type": {
      "required_for": ["/admin/login"],
      "value": "application/json"
    }
  },
  "base_url": "http://localhost:5000",
  "error_codes_summary": {
    "200": "Success",
    "400": "Bad Request - Invalid input parameters",
    "401": "Unauthorized - Missing or invalid authentication",
    "403": "Forbidden - Valid token but insufficient permissions",
    "404": "Not Found - Resource doesn't exist",
    "500": "Internal Server Error - Server-side error occurred"
  },
  "authentication_flow": {
    "step_1": "Call POST /admin/login with email and password",
    "step_2": "Receive JWT token in response",
    "step_3": "Include token in Authorization header for protected routes: 'Bearer <token>'",
    "step_4": "Token does not expire, use same token until logout (if implemented)"
  },
  "testing_examples": {
    "admin_login_curl": "curl -X POST http://localhost:5000/admin/login -H 'Content-Type: application/json' -d '{\"email\":\"tech@diarydad.me\",\"password\":\"adminpass1\"}'",
    "get_all_users_curl": "curl -X GET http://localhost:5000/admin/users -H 'Authorization: Bearer <token>'",
    "get_user_details_curl": "curl -X GET http://localhost:5000/admin/users/507f1f77bcf86cd799439011 -H 'Authorization: Bearer <token>'",
    "get_engagement_curl": "curl -X GET http://localhost:5000/admin/engagement -H 'Authorization: Bearer <token>'"
  }
}

