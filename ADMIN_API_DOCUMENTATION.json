{
  "admin_panel_apis": [
    {
      "route": "/admin/login",
      "method": "POST",
      "description": "Admin authentication endpoint. Authenticates admin using hardcoded credentials and returns a JWT token for accessing protected admin routes.",
      "authentication_required": false,
      "request": {
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "required_fields": [
            "email",
            "password"
          ],
          "example": {
            "email": "tech@diarydad.me",
            "password": "adminpass1"
          }
        },
        "query_parameters": null,
        "path_parameters": null
      },
      "response": {
        "success": {
          "status_code": 200,
          "body": {
            "message": "Admin login successful",
            "token": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9...",
            "email": "tech@diarydad.me"
          },
          "description": "Returns JWT token and admin email on successful authentication"
        },
        "errors": [
          {
            "status_code": 400,
            "body": {
              "error": "Email and password are required."
            },
            "description": "Missing email or password in request body"
          },
          {
            "status_code": 401,
            "body": {
              "error": "Invalid credentials."
            },
            "description": "Incorrect email or password"
          }
        ]
      },
      "notes": [
        "Hardcoded credentials: email='tech@diarydad.me', password='adminpass1'",
        "Token should be used in Authorization header as 'Bearer <token>' for protected routes",
        "Token does not expire (no expiry time set)"
      ]
    },
    {
      "route": "/admin/users",
      "method": "GET",
      "description": "Retrieves a list of all registered users with basic information. Returns users sorted by creation date (newest first).",
      "authentication_required": true,
      "auth_header": "Authorization: Bearer <admin_token>",
      "request": {
        "headers": {
          "Authorization": "Bearer <admin_token>"
        },
        "body": null,
        "query_parameters": null,
        "path_parameters": null
      },
      "response": {
        "success": {
          "status_code": 200,
          "body": {
            "users": [
              {
                "_id": "507f1f77bcf86cd799439011",
                "phone": "+1234567890",
                "name": "John Doe",
                "email": "john@example.com",
                "timezone": "America/New_York",
                "created_at": "2024-01-15T10:30:00"
              },
              {
                "_id": "507f1f77bcf86cd799439012",
                "phone": "+9876543210",
                "name": "Jane Smith",
                "email": "jane@example.com",
                "timezone": "Asia/Kolkata",
                "created_at": "2024-01-14T08:20:00"
              }
            ],
            "total": 2
          },
          "description": "Returns array of users with basic info and total count"
        },
        "errors": [
          {
            "status_code": 401,
            "body": {
              "error": "Authorization header missing"
            },
            "description": "No Authorization header provided"
          },
          {
            "status_code": 401,
            "body": {
              "error": "Invalid token"
            },
            "description": "Invalid or malformed JWT token"
          },
          {
            "status_code": 403,
            "body": {
              "error": "Admin access required"
            },
            "description": "Token is valid but user is not an admin"
          },
          {
            "status_code": 500,
            "body": {
              "error": "<error_message>"
            },
            "description": "Internal server error"
          }
        ]
      },
      "notes": [
        "Returns only basic user fields: _id, phone, name, email, timezone, created_at",
        "Users are sorted by created_at in descending order (newest first)",
        "Dates are returned in ISO 8601 format",
        "Empty users array is valid if no users exist"
      ]
    },
    {
      "route": "/admin/users/<user_id>",
      "method": "GET",
      "description": "Retrieves detailed information about a specific user including all profile data with base64 profile picture, all diary entries (full content for past 3 days with images, summary stats for older entries), and today's AI feature usage.",
      "authentication_required": true,
      "auth_header": "Authorization: Bearer <admin_token>",
      "request": {
        "headers": {
          "Authorization": "Bearer <admin_token>"
        },
        "body": null,
        "query_parameters": null,
        "path_parameters": {
          "user_id": {
            "type": "string",
            "required": true,
            "description": "MongoDB ObjectId of the user",
            "example": "507f1f77bcf86cd799439011"
          }
        }
      },
      "response": {
        "success": {
          "status_code": 200,
          "body": {
            "user": {
              "_id": "507f1f77bcf86cd799439011",
              "phone": "+1234567890",
              "name": "John Doe",
              "email": "john@example.com",
              "timezone": "America/New_York",
              "profile_pic_url": "/uploads/profile_pics/507f1f77bcf86cd799439011.jpg",
              "profile_pic": "data:image/jpeg;base64,/9j/4AAQSkZJRgABAQAAAQ...",
              "created_at": "2024-01-15T10:30:00",
              "total_diary_entries": 25,
              "last_diary_entry": "2024-01-20T14:30:00",
              "today_image_extractions": 2,
              "today_summary_generations": 1,
              "diaries": [
                {
                  "_id": "507f1f77bcf86cd799439012",
                  "date": "20-01-2024",
                  "created_at": "2024-01-20T14:30:00",
                  "last_update": "2024-01-20T15:45:00",
                  "diary": {
                    "content": "Today I went to the park...",
                    "summary": "A day at the park with friends"
                  },
                  "mood_tracker": ["happy", "excited"],
                  "expense_tracker": [
                    {
                      "name": "Lunch",
                      "amount": 15.50
                    }
                  ],
                  "health_stats": [
                    {
                      "name": "Steps",
                      "description": "Daily steps",
                      "value": 8500,
                      "unit": "steps"
                    }
                  ],
                  "update_log": [
                    {
                      "timestamp": "2024-01-20T14:30:00"
                    },
                    {
                      "timestamp": "2024-01-20T15:45:00"
                    }
                  ],
                  "image_extraction_count": 1,
                  "summary_generation_count": 1,
                  "images": [
                    {
                      "filename": "507f1f77bcf86cd799439011_20240120_143025.jpg",
                      "url": "/uploads/diary_images/507f1f77bcf86cd799439011_20240120_143025.jpg",
                      "base64": "data:image/jpeg;base64,/9j/4AAQSkZJRgABAQAAAQ..."
                    }
                  ]
                },
                {
                  "_id": "507f1f77bcf86cd799439013",
                  "date": "15-01-2024",
                  "created_at": "2024-01-15T10:00:00",
                  "last_update": "2024-01-15T10:00:00",
                  "image_extraction_count": 0,
                  "summary_generation_count": 0,
                  "type": "summary"
                }
              ]
            }
          },
          "description": "Returns complete user object with all profile fields, statistics, and diary entries. Profile picture is included as base64. Diaries from the past 3 calendar days include full content and images (as base64), older entries only include summary stats."
        },
        "errors": [
          {
            "status_code": 401,
            "body": {
              "error": "Authorization header missing"
            },
            "description": "No Authorization header provided"
          },
          {
            "status_code": 401,
            "body": {
              "error": "Invalid token"
            },
            "description": "Invalid or malformed JWT token"
          },
          {
            "status_code": 403,
            "body": {
              "error": "Admin access required"
            },
            "description": "Token is valid but user is not an admin"
          },
          {
            "status_code": 404,
            "body": {
              "error": "User not found."
            },
            "description": "User with given user_id does not exist"
          },
          {
            "status_code": 500,
            "body": {
              "error": "<error_message>"
            },
            "description": "Internal server error (e.g., invalid ObjectId format)"
          }
        ]
      },
      "notes": [
        "Returns all user fields from the database",
        "profile_pic: Base64 encoded profile picture image as data URI (includes data:image/jpeg;base64,...)",
        "total_diary_entries: Count of all diary entries created by the user",
        "last_diary_entry: ISO timestamp of the most recent diary entry (null if no entries)",
        "today_image_extractions: Number of image text extractions used today (resets daily)",
        "today_summary_generations: Number of summary generations used today (resets daily)",
        "Usage counts are based on today's diary entry (UTC date)",
        "diaries: Array of diary entries with different levels of detail:",
        "  - Past 3 calendar days: Full diary data including content, summary, mood_tracker, expense_tracker, health_stats, update_log, and images (as base64)",
        "  - Older entries: Only summary stats (date, created_at, last_update, image_extraction_count, summary_generation_count, type: 'summary')",
        "images: For recent diary entries, includes all diary images from that date as base64 encoded strings",
        "Diary images are matched by date by parsing the filename pattern: {user_id}_{YYYYMMDD}_{HHMMSS}.{ext}"
      ]
    },
    {
