{
  "info": {
    "name": "Diary App API",
    "description": "Complete API test collection for Diary App",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "phone",
      "value": "9876543210",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Request OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/request-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "request-otp"]
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Timezone",
                "value": "Asia/Kolkata"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/verify-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify-otp"]
            }
          }
        }
      ]
    },
    {
      "name": "User Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/user/profile",
              "host": ["{{base_url}}"],
              "path": ["user", "profile"]
            }
          }
        },
        {
          "name": "Update Profile (JSON)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"timezone\": \"America/New_York\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/user/profile",
              "host": ["{{base_url}}"],
              "path": ["user", "profile"]
            }
          }
        },
        {
          "name": "Update Profile with Image",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "John Doe",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "john@example.com",
                  "type": "text"
                },
                {
                  "key": "timezone",
                  "value": "Asia/Kolkata",
                  "type": "text"
                },
                {
                  "key": "profile_pic",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/user/profile",
              "host": ["{{base_url}}"],
              "path": ["user", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "Diary",
      "item": [
        {
          "name": "Create/Update Diary (Full)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"diary\": {\n    \"content\": \"Today was a great day! I went for a walk in the morning and had a productive afternoon.\",\n    \"summary\": \"Great day with morning walk and productive work\"\n  },\n  \"mood_tracker\": [\n    \"happy\",\n    \"energetic\",\n    \"focused\"\n  ],\n  \"expense_tracker\": [\n    {\n      \"name\": \"Lunch\",\n      \"amount\": 250.50\n    },\n    {\n      \"name\": \"Coffee\",\n      \"amount\": 120.00\n    }\n  ],\n  \"health_stats\": [\n    {\n      \"name\": \"Steps\",\n      \"description\": \"Daily step count\",\n      \"value\": 8500,\n      \"unit\": \"steps\"\n    },\n    {\n      \"name\": \"Water Intake\",\n      \"description\": \"Daily water consumption\",\n      \"value\": 2.5,\n      \"unit\": \"liters\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/diary",
              "host": ["{{base_url}}"],
              "path": ["diary"]
            }
          }
        },
        {
          "name": "Create/Update Diary (Minimal)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"diary\": {\n    \"content\": \"Quick note for today\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/diary",
              "host": ["{{base_url}}"],
              "path": ["diary"]
            }
          }
        },
        {
          "name": "Update Mood Only",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mood_tracker\": [\n    \"calm\",\n    \"grateful\",\n    \"peaceful\"\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/diary",
              "host": ["{{base_url}}"],
              "path": ["diary"]
            }
          }
        },
        {
          "name": "Get Diary by Date",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/diary?date=15-01-2024",
              "host": ["{{base_url}}"],
              "path": ["diary"],
              "query": [
                {
                  "key": "date",
                  "value": "15-01-2024"
                }
              ]
            }
          }
        },
        {
          "name": "Get Month Diaries",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/diary/month",
              "host": ["{{base_url}}"],
              "path": ["diary", "month"]
            }
          }
        },
        {
          "name": "Get All Diaries",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/diary/all",
              "host": ["{{base_url}}"],
              "path": ["diary", "all"]
            }
          }
        },
        {
          "name": "Delete Diary by Date",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/diary?date=15-01-2024",
              "host": ["{{base_url}}"],
              "path": ["diary"],
              "query": [
                {
                  "key": "date",
                  "value": "15-01-2024"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}

